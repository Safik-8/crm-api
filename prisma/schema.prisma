generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ══════════════════════════════════════
// COMPANY & BRANCH
// ══════════════════════════════════════

model Company {
  id        Int      @id @default(autoincrement())
  name      String
  code      String   @unique
  logo      String?
  industry  String?
  website   String?
  address   String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branches       Branch[]
  users          User[]
  userRoles      UserRole[]
  pipelines      Pipeline[]
  leadSources    LeadSource[]
  roles          Role[]
  passwordResets PasswordReset[]
  teams          Team[]          // NEW-S2
  courses        Course[]        // NEW-S2
  userProfiles   UserProfile[]   // NEW-S2
  auditLogs      AuditLog[]      // NEW-S2
  leads          Lead[]
  leadStatuses   LeadStatus[]
  leadImportLogs LeadImportLog[]

  @@map("companies")
}

model Branch {
  id        Int      @id @default(autoincrement())
  companyId Int      @map("company_id")
  name      String
  code      String
  address   String?
  location  String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company            Company             @relation(fields: [companyId], references: [id])
  users              User[]
  userRoles          UserRole[]
  pipelines          Pipeline[]
  dailyBranchReports DailyBranchReport[]
  teams              Team[]              // NEW-S2
  userProfiles       UserProfile[]       // NEW-S2
  leads              Lead[]
  leadImportLogs     LeadImportLog[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([code])
  @@map("branches")
}

// ══════════════════════════════════════
// USERS, ROLES & PERMISSIONS
// ══════════════════════════════════════

model User {
  id           Int       @id @default(autoincrement())
  companyId    Int?      @map("company_id")
  branchId     Int?      @map("branch_id")
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  status       String    @default("ACTIVE")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // ── NEW-S2 fields (additive, nullable) ──
  firstName          String?   @map("first_name")
  lastName           String?   @map("last_name")
  // NOTE: existing `name` field is KEPT for backward compatibility.
  // App layer must sync: name = `${firstName} ${lastName}`.trim()
  // on every create/update so existing code reading .name keeps working.

  mobileNumber       String?   @unique @map("mobile_number")
  employeeId         String?   @unique @map("employee_id")
  joiningDate        DateTime? @map("joining_date")
  profilePhoto       String?   @map("profile_photo")
  // FIX #1: profilePhoto lives ONLY here, not duplicated on UserProfile

  mustChangePassword Boolean   @default(false) @map("must_change_password")
  // FIX #3: needed for Task 1.8 "force password change on next login"
  // set true on admin-triggered reset, cleared after successful login

  reportingManagerId Int?      @map("reporting_manager_id")

  // ── Sprint 1 relations (unchanged) ──
  company                   Company?            @relation(fields: [companyId], references: [id])
  branch                    Branch?             @relation(fields: [branchId], references: [id])
  userRoles                 UserRole[]          @relation("UserToUserRole")
  assignedRoles             UserRole[]          @relation("AssignedByToUserRole")
  refreshTokens             RefreshToken[]
  createdLeads              Lead[]              @relation("UserCreatedLeads")
  assignedLeads             Lead[]              @relation("UserAssignedLeads")
  stageChangedLeads         Lead[]              @relation("UserStageChangedLeads")
  leadComments              LeadComment[]
  createdDailyBranchReports DailyBranchReport[] @relation("UserCreatedDailyBranchReports")
  createdRoles              Role[]              @relation("RoleCreatedBy")
  passwordResets            PasswordReset[]

  // ── NEW-S2 relations ──
  reportingManager    User?          @relation("UserReportingManager", fields: [reportingManagerId], references: [id])
  subordinates        User[]         @relation("UserReportingManager")
  profile             UserProfile?
  settings            UserSettings?
  ownedTeams          Team[]         @relation("TeamBDE")
  createdTeams        Team[]         @relation("TeamCreatedBy")
  updatedTeams        Team[]         @relation("TeamUpdatedBy")
  teamMemberships     TeamMember[]   @relation("TeamMemberUser")
  teamAssignmentsMade TeamMember[]   @relation("TeamMemberAssignedBy")
  createdCourses      Course[]       @relation("CourseCreatedBy")
  updatedCourses      Course[]       @relation("CourseUpdatedBy")
  auditLogsPerformed  AuditLog[]     @relation("AuditPerformedBy")

  // ── Sprint 3 relations ──
  updatedLeads      Lead[]          @relation("UserUpdatedLeads")
  deletedLeads      Lead[]          @relation("UserDeletedLeads")
  leadNoteCreated   LeadNote[]      @relation("LeadNoteCreatedBy")
  leadNoteUpdated   LeadNote[]      @relation("LeadNoteUpdatedBy")
  leadImportLogs    LeadImportLog[] @relation("LeadImportLogCreatedBy")

  @@index([companyId])
  @@index([branchId])
  @@index([reportingManagerId]) // NEW-S2 — FIX #10: index for hierarchy queries
  @@map("users")
}

model Role {
  id          Int      @id @default(autoincrement())
  companyId   Int?     @map("company_id")             // null = global system role, shared by all companies
  name        String                                   // role identifier — unique within company scope
  description String?
  rank        Int      @default(0)                     // authority level: Super Admin=100, Company Admin=80, Branch Manager=60, BDE/ISE=40
  isSystem    Boolean  @default(false) @map("is_system") // true = seeded role, locks rank & name, prevents deletion
  status      String   @default("ACTIVE")              // "ACTIVE" | "INACTIVE"
  createdBy   Int?     @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  company         Company?    @relation(fields: [companyId], references: [id])
  createdByUser   User?       @relation("RoleCreatedBy", fields: [createdBy], references: [id])
  userRoles       UserRole[]
  rolePermissions Permission[]

  @@unique([companyId, name])           // same name allowed per-company, no cross-company collision
  @@index([companyId])
  @@map("roles")
}

model UserRole {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  roleId     Int      @map("role_id")
  companyId  Int?     @map("company_id")
  branchId   Int?     @map("branch_id")
  isPrimary  Boolean  @default(false) @map("is_primary")
  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy Int?     @map("assigned_by")

  user           User     @relation("UserToUserRole", fields: [userId], references: [id])
  role           Role     @relation(fields: [roleId], references: [id])
  company        Company? @relation(fields: [companyId], references: [id])
  branch         Branch?  @relation(fields: [branchId], references: [id])
  assignedByUser User?    @relation("AssignedByToUserRole", fields: [assignedBy], references: [id])

  @@unique([userId, roleId, companyId, branchId])
  @@map("user_roles")
}

model Permission {
  id         Int      @id @default(autoincrement())
  roleId     Int      @map("role_id")
  module     String
  canView    Boolean  @default(false) @map("can_view")
  canCreate  Boolean  @default(false) @map("can_create")
  canEdit    Boolean  @default(false) @map("can_edit")
  canDelete  Boolean  @default(false) @map("can_delete")
  canArchive Boolean  @default(false) @map("can_archive")
  createdAt  DateTime @default(now()) @map("created_at")

  role Role @relation(fields: [roleId], references: [id])

  @@unique([roleId, module])
  @@map("permissions")
}

model RefreshToken {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  token      String    @unique
  browser    String?
  os         String?
  deviceName String?
  ipAddress  String?   @map("ip_address")
  lastActive DateTime? @default(now()) @map("last_active")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

// OTP-based password reset — linked to user_id + company_id for audit trail
model PasswordReset {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  companyId  Int?     @map("company_id")  // denormalized from user at creation time
  otp        String
  isVerified Boolean  @default(false) @map("is_verified")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id])
  company Company? @relation(fields: [companyId], references: [id])

  @@index([userId])
  @@index([companyId])
  @@map("password_resets")
}

// ══════════════════════════════════════
// LEAD SOURCE
// ══════════════════════════════════════

model LeadSource {
  id          Int       @id @default(autoincrement())
  companyId   Int?      @map("company_id")   // null = global system source
  name        String
  description String?                        // FIX: Task 2.3 — was missing
  isActive    Boolean   @default(true) @map("is_active")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")  // FIX: was missing

  company Company? @relation(fields: [companyId], references: [id])
  leads   Lead[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("lead_sources")
}

// ══════════════════════════════════════
// PIPELINE MANAGEMENT
// ══════════════════════════════════════

model Pipeline {
  id          Int      @id @default(autoincrement())
  branchId    Int      @map("branch_id")
  companyId   Int      @map("company_id")
  name        String
  isDeleted   Boolean  @default(false) @map("is_deleted")
  createdById Int      @map("created_by")
  updatedById Int?     @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  branch         Branch          @relation(fields: [branchId], references: [id])
  company        Company         @relation(fields: [companyId], references: [id])
  stages         PipelineStage[]
  leads          Lead[]
  leadImportLogs LeadImportLog[]

  @@index([branchId])
  @@index([companyId])
  @@map("pipelines")
}

// Global stages shared across all pipelines
// is_default = true means "Prospect" stage
model Stage {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  isDefault   Boolean  @default(false) @map("is_default")
  isDeleted   Boolean  @default(false) @map("is_deleted")
  createdById Int      @map("created_by")
  updatedById Int?     @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  pipelineStages     PipelineStage[]
  leads              Lead[]
  leadsPreviousStage Lead[] @relation("LeadPreviousStage")

  @@map("stages")
}

model PipelineStage {
  id         Int @id @default(autoincrement())
  pipelineId Int @map("pipeline_id")
  stageId    Int @map("stage_id")
  orderNo    Int @map("order_no")

  pipeline Pipeline @relation(fields: [pipelineId], references: [id])
  stage    Stage    @relation(fields: [stageId], references: [id])

  @@unique([pipelineId, stageId])
  @@index([pipelineId])
  @@map("pipeline_stages")
}

// ══════════════════════════════════════
// LEAD
// ══════════════════════════════════════

model Lead {
  id               Int       @id @default(autoincrement())

  // ── TENANT SCOPE (direct — no pipeline join required) ──────────
  companyId        Int?      @map("company_id")
  branchId         Int?      @map("branch_id")

  // ── PIPELINE (optional — Kanban view only) ──────────────────────
  // A lead can exist without a pipeline (list view entry)
  // A lead enters a pipeline when added to Kanban board
  pipelineId       Int?      @map("pipeline_id")
  stageId          Int?      @map("stage_id")
  previousStageId  Int?      @map("previous_stage_id")
  stageChangedById Int?      @map("stage_changed_by_id")
  stageChangedAt   DateTime? @map("stage_changed_at")

  // ── MANDATORY RELATIONS ─────────────────────────────────────────
  sourceId         Int?      @map("source_id")   // mandatory at app layer
  courseId         Int?      @map("course_id")    // mandatory at app layer
  statusId         Int?      @map("status_id")    // mandatory at app layer; nullable for migration safety

  // ── ASSIGNMENT ──────────────────────────────────────────────────
  assignedToId     Int?      @map("assigned_to")
  teamId           Int?      @map("team_id")

  // ── MANDATORY CONTACT ───────────────────────────────────────────
  name             String
  mobile           String

  // ── OPTIONAL CONTACT ────────────────────────────────────────────
  email            String?
  alternateMobile  String?   @map("alternate_mobile")

  // ── LEAD DETAILS ────────────────────────────────────────────────
  priority         String    @default("MEDIUM")   // "HIGH" | "MEDIUM" | "LOW"
  budget           Decimal?  @db.Decimal(10, 2)
  city             String?
  state            String?
  country          String?
  notes            String?   @db.Text             // quick single-field note on lead

  // ── DUPLICATE TRACKING (Task 7) ─────────────────────────────────
  isDuplicate      Boolean   @default(false) @map("is_duplicate")
  duplicateOfId    Int?      @map("duplicate_of_id")  // self-reference to original lead

  // ── BACKWARD COMPAT ─────────────────────────────────────────────
  date             DateTime  @default(now())
  interestedFor    String?   @map("interested_for")  // DEPRECATED: kept for Kanban, use courseId

  // ── SOFT DELETE (Task 1.6) ──────────────────────────────────────
  isDeleted        Boolean   @default(false) @map("is_deleted")
  deletedById      Int?      @map("deleted_by")
  deletedAt        DateTime? @map("deleted_at")

  // ── AUDIT ───────────────────────────────────────────────────────
  createdById      Int       @map("created_by")
  updatedById      Int?      @map("updated_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // ── RELATIONS ───────────────────────────────────────────────────
  company        Company?      @relation(fields: [companyId], references: [id])
  branch         Branch?       @relation(fields: [branchId], references: [id])
  pipeline       Pipeline?     @relation(fields: [pipelineId], references: [id])
  stage          Stage?        @relation(fields: [stageId], references: [id])
  previousStage  Stage?        @relation("LeadPreviousStage", fields: [previousStageId], references: [id])
  stageChangedBy User?         @relation("UserStageChangedLeads", fields: [stageChangedById], references: [id])
  source         LeadSource?   @relation(fields: [sourceId], references: [id])
  course         Course?       @relation(fields: [courseId], references: [id])
  status         LeadStatus?   @relation(fields: [statusId], references: [id])
  assignedTo     User?         @relation("UserAssignedLeads", fields: [assignedToId], references: [id])
  team           Team?         @relation(fields: [teamId], references: [id])
  duplicateOf    Lead?         @relation("LeadDuplicate", fields: [duplicateOfId], references: [id])
  duplicates     Lead[]        @relation("LeadDuplicate")
  createdBy      User          @relation("UserCreatedLeads", fields: [createdById], references: [id])
  updatedBy      User?         @relation("UserUpdatedLeads", fields: [updatedById], references: [id])
  deletedBy      User?         @relation("UserDeletedLeads", fields: [deletedById], references: [id])
  comments       LeadComment[]
  leadNotes      LeadNote[]

  // ── INDEXES ─────────────────────────────────────────────────────
  @@index([companyId])
  @@index([branchId])
  @@index([pipelineId])
  @@index([stageId])
  @@index([previousStageId])
  @@index([sourceId])
  @@index([courseId])
  @@index([statusId])
  @@index([assignedToId])
  @@index([teamId])
  @@index([mobile])                    // fast single-field lookup
  @@index([email])                     // fast email duplicate detection
  @@index([alternateMobile])           // FIX: Task 7.4 alternate contact dup detection
  @@index([companyId, mobile])         // compound: duplicate check within company scope
  @@index([isDuplicate])               // filter duplicates fast
  @@index([createdAt])                 // date range filter
  @@map("leads")
}

// ══════════════════════════════════════
// LEAD STATUS MASTER
// ══════════════════════════════════════

model LeadStatus {
  id            Int      @id @default(autoincrement())
  companyId     Int?     @map("company_id")       // null = global system status
  name          String                             // "New", "Open", "Contacted"
  code          String                             // "NEW", "OPEN", "CONTACTED"
  displayColor  String   @map("display_color")    // hex: "#3b82f6"
  sequenceOrder Int      @default(0) @map("sequence_order")
  isDefault     Boolean  @default(false) @map("is_default")  // auto-assigned on lead create
  isSystem      Boolean  @default(false) @map("is_system")   // prevents deletion
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  company Company? @relation(fields: [companyId], references: [id])
  leads   Lead[]

  @@unique([companyId, code])   // same code allowed per-company, no cross-company collision
  @@index([companyId])
  @@map("lead_statuses")
}

// ══════════════════════════════════════
// LEAD NOTES
// ══════════════════════════════════════

model LeadNote {
  id          Int      @id @default(autoincrement())
  leadId      Int      @map("lead_id")
  note        String   @db.Text
  isDeleted   Boolean  @default(false) @map("is_deleted")
  createdById Int      @map("created_by")
  updatedById Int?     @map("updated_by")    // FIX: who last edited this note
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  lead      Lead  @relation(fields: [leadId], references: [id])
  createdBy User  @relation("LeadNoteCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("LeadNoteUpdatedBy", fields: [updatedById], references: [id])

  @@index([leadId])
  @@map("lead_notes")
}

// ══════════════════════════════════════
// LEAD IMPORT LOGS
// ══════════════════════════════════════

model LeadImportLog {
  id             Int      @id @default(autoincrement())
  companyId      Int      @map("company_id")
  branchId       Int      @map("branch_id")
  pipelineId     Int?     @map("pipeline_id")   // optional: set when imported via Kanban
  fileName       String   @map("file_name")
  totalRows      Int      @map("total_rows")
  successCount   Int      @default(0) @map("success_count")
  failureCount   Int      @default(0) @map("failure_count")
  duplicateCount Int      @default(0) @map("duplicate_count")  // rows flagged as duplicate
  status         String   @default("COMPLETED") // "COMPLETED" | "PARTIAL" | "FAILED"
  errorReport    Json?    @map("error_report")  // full downloadable error data (Task 4.7)
  createdById    Int      @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  company   Company   @relation(fields: [companyId], references: [id])
  branch    Branch    @relation(fields: [branchId], references: [id])
  pipeline  Pipeline? @relation(fields: [pipelineId], references: [id])
  createdBy User      @relation("LeadImportLogCreatedBy", fields: [createdById], references: [id])

  @@index([companyId])
  @@index([branchId])
  @@index([createdById])
  @@map("lead_import_logs")
}


// ══════════════════════════════════════
// LEAD COMMENT
// ══════════════════════════════════════

model LeadComment {
  id          Int      @id @default(autoincrement())
  leadId      Int      @map("lead_id")
  userId      Int      @map("user_id")
  comment     String
  isDeleted   Boolean  @default(false) @map("is_deleted")
  createdById Int      @map("created_by")
  updatedById Int?     @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  lead Lead @relation(fields: [leadId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@index([leadId])
  @@map("lead_comments")
}

// ══════════════════════════════════════
// DAILY BRANCH REPORTS
// ══════════════════════════════════════

model DailyBranchReport {
  id Int @id @default(autoincrement())

  branchId   Int      @map("branch_id")
  reportDate DateTime @map("report_date") // store date-only at 00:00:00

  callsReceived      Int     @default(0) @map("calls_received")
  qualifiedLeads     Int     @default(0) @map("qualified_leads")
  counsellingDone    Int     @default(0) @map("counselling_done")
  counsellingBooked  Int     @default(0) @map("counselling_booked")
  officeVisits       Int     @default(0) @map("office_visits")
  closures           Int     @default(0) @map("closures")
  followupsDone      Int     @default(0) @map("followups_done")
  pendingFollowups   Int     @default(0) @map("pending_followups")

  isDeleted   Boolean  @default(false) @map("is_deleted")
  createdById Int      @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  // updatedAt removed: daily reports are submit-once (no updates)

  branch    Branch @relation(fields: [branchId], references: [id])
  createdBy User   @relation("UserCreatedDailyBranchReports", fields: [createdById], references: [id])

  // multiple users can submit for same branch+date, but each user only once
  @@unique([branchId, reportDate, createdById])
  @@index([branchId])
  @@index([createdById])
  @@map("daily_branch_reports")
}

// ══════════════════════════════════════════════════════════════
// SPRINT 2 — NEW TABLES
// ══════════════════════════════════════════════════════════════

// ══════════════════════════════════════
// USER PROFILE — extended personal info (1:1 with User)
// ══════════════════════════════════════

model UserProfile {
  id               Int      @id @default(autoincrement())
  userId           Int      @unique @map("user_id")
  companyId        Int?     @map("company_id")   // denormalized for tenant isolation
  branchId         Int?     @map("branch_id")    // denormalized for tenant isolation

  address          String?
  city             String?
  state            String?
  country          String?
  pincode          String?                        // FIX #11: postal/zip code
  emergencyContact String?  @map("emergency_contact")

  // FIX #1: profilePhoto intentionally NOT here — lives only on User

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id])
  company Company? @relation(fields: [companyId], references: [id])
  branch  Branch?  @relation(fields: [branchId], references: [id])

  @@index([companyId])
  @@index([branchId])
  @@map("user_profiles")
}

// ══════════════════════════════════════
// USER SETTINGS — Task 2.6 notification/session/security preferences
// FIX #12: was missing entirely
// ══════════════════════════════════════

model UserSettings {
  id                      Int      @id @default(autoincrement())
  userId                  Int      @unique @map("user_id")

  notificationPreferences Json?    @map("notification_preferences")
  sessionPreferences      Json?    @map("session_preferences")
  securitySettings        Json?    @map("security_settings")

  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("user_settings")
}

// ══════════════════════════════════════
// TEAM MANAGEMENT
// ══════════════════════════════════════

model Team {
  id          Int      @id @default(autoincrement())
  companyId   Int      @map("company_id")
  branchId    Int      @map("branch_id")
  name        String   @map("team_name")
  code        String   @map("team_code")
  bdeId       Int      @map("bde_id")             // team owner — exactly one BDE
  status      String   @default("ACTIVE")
  isDeleted   Boolean  @default(false) @map("is_deleted")
  createdById Int      @map("created_by")
  updatedById Int?     @map("updated_by")          // FIX A: relation now defined
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company   Company      @relation(fields: [companyId], references: [id])
  branch    Branch       @relation(fields: [branchId], references: [id])
  bde       User         @relation("TeamBDE", fields: [bdeId], references: [id])
  createdBy User         @relation("TeamCreatedBy", fields: [createdById], references: [id])
  updatedBy User?        @relation("TeamUpdatedBy", fields: [updatedById], references: [id]) // FIX A
  members   TeamMember[]
  leads     Lead[]

  // FIX #4: team_code unique PER COMPANY, not globally
  @@unique([companyId, code])
  @@unique([branchId, name])       // team name unique within a branch
  @@index([companyId])
  @@index([branchId])
  @@index([bdeId])
  @@map("teams")
}

model TeamMember {
  id             Int       @id @default(autoincrement())
  teamId         Int       @map("team_id")
  userId         Int       @map("user_id")
  memberRole     String    @map("member_role")     // "BDE" | "ISE"
  assignedDate   DateTime  @default(now()) @map("assigned_date")
  assignedById   Int?      @map("assigned_by_id")
  // FIX #6: records WHO made the assignment — audit trail

  removedAt      DateTime? @map("removed_at")
  // FIX #5: single source of truth for membership state.
  // removedAt IS NULL  → active member
  // removedAt IS SET   → removed member (history preserved)
  // Dropped redundant status + isDeleted fields

  createdAt      DateTime  @default(now()) @map("created_at")

  team       Team  @relation(fields: [teamId], references: [id])
  user       User  @relation("TeamMemberUser", fields: [userId], references: [id])
  assignedBy User? @relation("TeamMemberAssignedBy", fields: [assignedById], references: [id])

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

// ══════════════════════════════════════
// COURSE / PRODUCT MASTER
// ══════════════════════════════════════

model Course {
  id             Int      @id @default(autoincrement())
  companyId      Int      @map("company_id")
  name           String   @map("course_name")
  code           String   @map("course_code")
  description    String?                              // FIX #9: was missing
  category       String
  parentCategory String?  @map("parent_category")
  price          Decimal  @db.Decimal(10, 2)
  duration       String?
  status         String   @default("ACTIVE")
  isDeleted      Boolean  @default(false) @map("is_deleted")
  createdById    Int      @map("created_by")
  updatedById    Int?     @map("updated_by")           // FIX A: relation now defined
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  company   Company @relation(fields: [companyId], references: [id])
  createdBy User    @relation("CourseCreatedBy", fields: [createdById], references: [id])
  updatedBy User?   @relation("CourseUpdatedBy", fields: [updatedById], references: [id]) // FIX A
  leads     Lead[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([category])
  @@map("courses")
}

// ══════════════════════════════════════
// GENERIC AUDIT LOG
// ══════════════════════════════════════

model AuditLog {
  id            Int      @id @default(autoincrement())
  companyId     Int?     @map("company_id")
  // FIX #7: added for tenant-scoped queries without entity joins

  entityType    String   @map("entity_type")   // "USER" | "TEAM" | "COURSE" | "ROLE" ...
  entityId      Int      @map("entity_id")
  action        String                          // "CREATE" | "UPDATE" | "STATUS_CHANGE" | "PASSWORD_RESET" | "MANAGER_CHANGE" | "MEMBER_REMOVE" ...

  oldValue      Json?    @map("old_value")      // FIX #8: native Json, not varchar
  newValue      Json?    @map("new_value")      // FIX #8: native Json, not varchar

  performedById Int?     @map("performed_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  company     Company? @relation(fields: [companyId], references: [id])
  performedBy User?    @relation("AuditPerformedBy", fields: [performedById], references: [id])

  @@index([companyId])
  @@index([entityType, entityId])
  @@index([performedById])
  @@map("audit_logs")
}
