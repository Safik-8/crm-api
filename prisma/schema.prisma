generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// COMPANY & BRANCH
// ============================================================================

model Company {
  id        Int      @id @default(autoincrement())
  name      String
  code      String   @unique
  logo      String?
  industry  String?
  website   String?
  address   String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branches          Branch[]
  users             User[]
  userRoles         UserRole[]
  pipelines         Pipeline[]
  leadSources       LeadSource[]
  roles             Role[]
  passwordResets    PasswordReset[]
  teams             Team[]
  courses           Course[]
  userProfiles      UserProfile[]
  auditLogs         AuditLog[]
  leads             Lead[]
  leadStatuses      LeadStatus[]
  leadImportLogs    LeadImportLog[]
  leadAssignments   LeadAssignment[]
  pipelineHistory   PipelineHistory[]
  followups         Followup[]
  notifications     Notification[]
  leadActivities    LeadActivity[]
  communicationLogs CommunicationLog[]

  // SPRINT 5 RELATIONS
  leadQualifications         LeadQualification[]
  leadQualificationHistories LeadQualificationHistory[]
  qualificationCriteria      CompanyQualificationCriteria[]
  qualificationSettings      CompanyQualificationSettings?
  opportunityStages          OpportunityStage[]
  opportunities              Opportunity[]
  opportunityStageHistories  OpportunityStageHistory[]
  proposals                  Proposal[]
  proposalVersions           ProposalVersion[]
  winLossReasons             WinLossReason[]
  deals                      Deal[]
  dealHistories              DealHistory[]
  customers                  Customer[]
  revenueLogs                RevenueLog[]

  // SPRINT 6 RELATIONS
  reports              Report[]
  reportFilters        ReportFilter[]
  dashboardWidgets     DashboardWidget[]
  userDashboardConfigs UserDashboardConfig[]
  kpiTargets           KpiTarget[]
  kpiAchievementLogs   KpiAchievementLog[]
  exportLogs           ExportLog[]
  analyticsSnapshots   AnalyticsSnapshot[]

  @@map("companies")
}

model Branch {
  id                        Int      @id @default(autoincrement())
  companyId                 Int      @map("company_id")
  name                      String
  code                      String
  address                   String?
  location                  String?
  status                    String   @default("ACTIVE")
  maxDailyLeadsPerUser      Int?     @map("max_daily_leads_per_user")
  autoAssignmentEnabled     Boolean  @default(false) @map("auto_assignment_enabled")
  assignmentAlgorithm       String?  @map("assignment_algorithm")
  assignmentResolutionLevel String   @default("PERSON") @map("assignment_resolution_level")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  company            Company             @relation(fields: [companyId], references: [id])
  users              User[]
  userRoles          UserRole[]
  pipelines          Pipeline[]
  dailyBranchReports DailyBranchReport[]
  teams              Team[]
  userProfiles       UserProfile[]
  leads              Lead[]
  leadImportLogs     LeadImportLog[]
  leadAssignments    LeadAssignment[]
  pipelineHistory    PipelineHistory[]
  followups          Followup[]
  notifications      Notification[]
  communicationLogs  CommunicationLog[]

  // SPRINT 5 RELATIONS
  opportunities             Opportunity[]
  opportunityStageHistories OpportunityStageHistory[]
  proposals                 Proposal[]
  proposalVersions          ProposalVersion[]
  deals                     Deal[]
  dealHistories             DealHistory[]
  customers                 Customer[]
  revenueLogs               RevenueLog[]
  leadQualifications        LeadQualification[]
  leadQualificationHistories LeadQualificationHistory[]

  // SPRINT 6 RELATIONS
  reportFilters      ReportFilter[]
  kpiTargets         KpiTarget[]
  exportLogs         ExportLog[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([code])
  @@map("branches")
}

// ============================================================================
// USERS, ROLES & PERMISSIONS
// ============================================================================

model User {
  id                 Int       @id @default(autoincrement())
  companyId          Int?      @map("company_id")
  branchId           Int?      @map("branch_id")
  name               String
  email              String    @unique
  passwordHash       String    @map("password_hash")
  status             String    @default("ACTIVE")
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  firstName          String?   @map("first_name")
  lastName           String?   @map("last_name")
  mobileNumber       String?   @unique @map("mobile_number")
  employeeId         String?   @unique @map("employee_id")
  joiningDate        DateTime? @map("joining_date")
  profilePhoto       String?   @map("profile_photo")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  reportingManagerId Int?      @map("reporting_manager_id")

  company                   Company?            @relation(fields: [companyId], references: [id])
  branch                    Branch?             @relation(fields: [branchId], references: [id])
  userRoles                 UserRole[]          @relation("UserToUserRole")
  assignedRoles             UserRole[]          @relation("AssignedByToUserRole")
  refreshTokens             RefreshToken[]
  createdLeads              Lead[]              @relation("UserCreatedLeads")
  assignedLeads             Lead[]              @relation("UserAssignedLeads")
  stageChangedLeads         Lead[]              @relation("UserStageChangedLeads")
  leadComments              LeadComment[]
  createdDailyBranchReports DailyBranchReport[] @relation("UserCreatedDailyBranchReports")
  createdRoles              Role[]              @relation("RoleCreatedBy")
  passwordResets            PasswordReset[]
  reportingManager          User?               @relation("UserReportingManager", fields: [reportingManagerId], references: [id])
  subordinates              User[]              @relation("UserReportingManager")
  profile                   UserProfile?
  settings                  UserSettings?
  ownedTeams                Team[]              @relation("TeamBDE")
  createdTeams              Team[]              @relation("TeamCreatedBy")
  updatedTeams              Team[]              @relation("TeamUpdatedBy")
  teamMemberships           TeamMember[]        @relation("TeamMemberUser")
  teamAssignmentsMade       TeamMember[]        @relation("TeamMemberAssignedBy")
  createdCourses            Course[]            @relation("CourseCreatedBy")
  updatedCourses            Course[]            @relation("CourseUpdatedBy")
  auditLogsPerformed        AuditLog[]          @relation("AuditPerformedBy")

  updatedLeads              Lead[]             @relation("UserUpdatedLeads")
  deletedLeads              Lead[]             @relation("UserDeletedLeads")
  leadNoteCreated           LeadNote[]         @relation("LeadNoteCreatedBy")
  leadNoteUpdated           LeadNote[]         @relation("LeadNoteUpdatedBy")
  leadImportLogs            LeadImportLog[]    @relation("LeadImportLogCreatedBy")
  leadAssignmentsReceived   LeadAssignment[]   @relation("LeadAssignmentsReceived")
  leadAssignmentsAsPrevious LeadAssignment[]   @relation("LeadAssignmentsAsPrevious")
  leadAssignmentsMade       LeadAssignment[]   @relation("LeadAssignmentsMade")
  pipelineChangesMade       PipelineHistory[]  @relation("PipelineChangesMade")
  followupsAssigned         Followup[]         @relation("FollowupsAssigned")
  followupsCreated          Followup[]         @relation("FollowupsCreated")
  followupsCompleted        Followup[]         @relation("FollowupsCompleted")
  followupsUpdated          Followup[]         @relation("FollowupsUpdated")
  notificationsReceived     Notification[]     @relation("NotificationsReceived")
  leadActivitiesPerformed   LeadActivity[]     @relation("LeadActivitiesPerformed")
  communicationLogsCreated  CommunicationLog[] @relation("CommunicationLogsCreated")
  communicationLogsDeleted  CommunicationLog[] @relation("CommunicationLogsDeleted")

  // SPRINT 5 RELATIONS
  qualifiedLeads                LeadQualification[]        @relation("LeadQualifiedBy")
  qualificationHistoriesChanged LeadQualificationHistory[] @relation("QualificationHistoryChangedBy")
  createdOpportunityStages      OpportunityStage[]         @relation("OpportunityStageCreatedBy")
  updatedOpportunityStages      OpportunityStage[]         @relation("OpportunityStageUpdatedBy")
  ownedOpportunities            Opportunity[]              @relation("OpportunityOwner")
  createdOpportunities          Opportunity[]              @relation("OpportunityCreatedBy")
  updatedOpportunities          Opportunity[]              @relation("OpportunityUpdatedBy")
  opportunityStageChangesMade   OpportunityStageHistory[]  @relation("OpportunityStageChangedBy")
  createdProposals              Proposal[]                 @relation("ProposalCreatedBy")
  updatedProposals              Proposal[]                 @relation("ProposalUpdatedBy")
  deletedProposals              Proposal[]                 @relation("ProposalDeletedBy")
  createdProposalVersions       ProposalVersion[]          @relation("ProposalVersionCreatedBy")
  createdWinLossReasons         WinLossReason[]            @relation("WinLossReasonCreatedBy")
  closedDeals                   Deal[]                     @relation("DealClosedBy")
  createdDeals                  Deal[]                     @relation("DealCreatedBy")
  updatedDeals                  Deal[]                     @relation("DealUpdatedBy")
  dealHistoriesCreated          DealHistory[]              @relation("DealHistoryCreatedBy")
  ownedCustomers                Customer[]                 @relation("CustomerOwner")
  createdCustomers              Customer[]                 @relation("CustomerCreatedBy")
  updatedCustomers              Customer[]                 @relation("CustomerUpdatedBy")
  deletedCustomers              Customer[]                 @relation("CustomerDeletedBy")
  createdRevenueLogs            RevenueLog[]               @relation("RevenueLogCreatedBy")

  // SPRINT 6 RELATIONS
  reportsCreated       Report[]             @relation("ReportCreatedBy")
  reportsUpdated       Report[]             @relation("ReportUpdatedBy")
  userFavoriteReports  UserFavoriteReport[]
  reportViewLogs       ReportViewLog[]
  savedReportFilters   ReportFilter[]       @relation("UserSavedReportFilters")
  dashboardConfig      UserDashboardConfig?
  kpiTargets           KpiTarget[]          @relation("UserKpiTargets")
  kpiTargetsCreated    KpiTarget[]          @relation("KpiTargetCreatedBy")
  kpiTargetsUpdated    KpiTarget[]          @relation("KpiTargetUpdatedBy")
  exportLogs           ExportLog[]          @relation("UserExportLogs")

  @@index([companyId])
  @@index([branchId])
  @@index([reportingManagerId])
  @@map("users")
}

model Role {
  id          Int      @id @default(autoincrement())
  companyId   Int?     @map("company_id")
  name        String
  description String?
  rank        Int      @default(0)
  isSystem    Boolean  @default(false) @map("is_system")
  status      String   @default("ACTIVE")
  createdBy   Int?     @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  company         Company?     @relation(fields: [companyId], references: [id])
  createdByUser   User?        @relation("RoleCreatedBy", fields: [createdBy], references: [id])
  userRoles       UserRole[]
  rolePermissions Permission[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("roles")
}

model UserRole {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  roleId     Int      @map("role_id")
  companyId  Int?     @map("company_id")
  branchId   Int?     @map("branch_id")
  isPrimary  Boolean  @default(false) @map("is_primary")
  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy Int?     @map("assigned_by")

  user           User     @relation("UserToUserRole", fields: [userId], references: [id])
  role           Role     @relation(fields: [roleId], references: [id])
  company        Company? @relation(fields: [companyId], references: [id])
  branch         Branch?  @relation(fields: [branchId], references: [id])
  assignedByUser User?    @relation("AssignedByToUserRole", fields: [assignedBy], references: [id])

  @@unique([userId, roleId, companyId, branchId])
  @@map("user_roles")
}

model Permission {
  id         Int      @id @default(autoincrement())
  roleId     Int      @map("role_id")
  module     String
  canView    Boolean  @default(false) @map("can_view")
  canCreate  Boolean  @default(false) @map("can_create")
  canEdit    Boolean  @default(false) @map("can_edit")
  canDelete  Boolean  @default(false) @map("can_delete")
  canArchive Boolean  @default(false) @map("can_archive")
  createdAt  DateTime @default(now()) @map("created_at")

  role Role @relation(fields: [roleId], references: [id])

  @@unique([roleId, module])
  @@map("permissions")
}

model RefreshToken {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  token      String    @unique
  browser    String?
  os         String?
  deviceName String?
  ipAddress  String?   @map("ip_address")
  lastActive DateTime? @default(now()) @map("last_active")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordReset {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  companyId  Int?     @map("company_id")
  otp        String
  isVerified Boolean  @default(false) @map("is_verified")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id])
  company Company? @relation(fields: [companyId], references: [id])

  @@index([userId])
  @@index([companyId])
  @@map("password_resets")
}

// ============================================================================
// LEAD SOURCE & PIPELINE
// ============================================================================

model LeadSource {
  id          Int       @id @default(autoincrement())
  companyId   Int?      @map("company_id")
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  company Company? @relation(fields: [companyId], references: [id])
  leads   Lead[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("lead_sources")
}

model Pipeline {
  id          Int      @id @default(autoincrement())
  branchId    Int      @map("branch_id")
  companyId   Int      @map("company_id")
  name        String
  isDeleted   Boolean  @default(false) @map("is_deleted")
  createdById Int      @map("created_by")
  updatedById Int?     @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  branch         Branch          @relation(fields: [branchId], references: [id])
  company        Company         @relation(fields: [companyId], references: [id])
  stages         PipelineStage[]
  leads          Lead[]
  leadImportLogs LeadImportLog[]

  @@index([branchId])
  @@index([companyId])
  @@map("pipelines")
}

model Stage {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  isDefault    Boolean  @default(false) @map("is_default")
  isDeleted    Boolean  @default(false) @map("is_deleted")
  createdById  Int      @map("created_by")
  updatedById  Int?     @map("updated_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  code         String?  @unique
  displayOrder Int      @default(0) @map("display_order")
  colorCode    String?  @map("color_code")
  status       String   @default("ACTIVE")
  stageType    String   @default("REGULAR") @map("stage_type")

  pipelineStages          PipelineStage[]
  leads                   Lead[]
  leadsPreviousStage      Lead[]            @relation("LeadPreviousStage")
  pipelineHistoryPrevious PipelineHistory[] @relation("PipelineHistoryPreviousStage")
  pipelineHistoryNew      PipelineHistory[] @relation("PipelineHistoryNewStage")

  @@map("stages")
}

model PipelineStage {
  id         Int @id @default(autoincrement())
  pipelineId Int @map("pipeline_id")
  stageId    Int @map("stage_id")
  orderNo    Int @map("order_no")

  pipeline Pipeline @relation(fields: [pipelineId], references: [id])
  stage    Stage    @relation(fields: [stageId], references: [id])

  @@unique([pipelineId, stageId])
  @@index([pipelineId])
  @@map("pipeline_stages")
}

// ============================================================================
// LEAD
// ============================================================================

model Lead {
  id Int @id @default(autoincrement())

  companyId Int? @map("company_id")
  branchId  Int? @map("branch_id")

  pipelineId       Int?      @map("pipeline_id")
  stageId          Int?      @map("stage_id")
  previousStageId  Int?      @map("previous_stage_id")
  stageChangedById Int?      @map("stage_changed_by_id")
  stageChangedAt   DateTime? @map("stage_changed_at")

  sourceId Int? @map("source_id")
  courseId Int? @map("course_id")
  statusId Int? @map("status_id")

  assignedToId Int? @map("assigned_to")
  teamId       Int? @map("team_id")

  name            String
  mobile          String
  email           String?
  alternateMobile String? @map("alternate_mobile")

  priority String   @default("MEDIUM")
  budget   Decimal? @db.Decimal(10, 2)
  city     String?
  state    String?
  country  String?
  notes    String?  @db.Text

  isDuplicate   Boolean @default(false) @map("is_duplicate")
  duplicateOfId Int?    @map("duplicate_of_id")

  date          DateTime @default(now())
  interestedFor String?  @map("interested_for")

  qualificationStatus String  @default("UNQUALIFIED") @map("qualification_status")
  qualificationScore  Int?    @map("qualification_score")
  isQualified         Boolean @default(false) @map("is_qualified")

  isDeleted   Boolean   @default(false) @map("is_deleted")
  deletedById Int?      @map("deleted_by")
  deletedAt   DateTime? @map("deleted_at")

  createdById Int      @map("created_by")
  updatedById Int?     @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company           Company?           @relation(fields: [companyId], references: [id])
  branch            Branch?            @relation(fields: [branchId], references: [id])
  pipeline          Pipeline?          @relation(fields: [pipelineId], references: [id])
  stage             Stage?             @relation(fields: [stageId], references: [id])
  previousStage     Stage?             @relation("LeadPreviousStage", fields: [previousStageId], references: [id])
  stageChangedBy    User?              @relation("UserStageChangedLeads", fields: [stageChangedById], references: [id])
  source            LeadSource?        @relation(fields: [sourceId], references: [id])
  course            Course?            @relation(fields: [courseId], references: [id])
  status            LeadStatus?        @relation(fields: [statusId], references: [id])
  assignedTo        User?              @relation("UserAssignedLeads", fields: [assignedToId], references: [id])
  team              Team?              @relation(fields: [teamId], references: [id])
  duplicateOf       Lead?              @relation("LeadDuplicate", fields: [duplicateOfId], references: [id])
  duplicates        Lead[]             @relation("LeadDuplicate")
  createdBy         User               @relation("UserCreatedLeads", fields: [createdById], references: [id])
  updatedBy         User?              @relation("UserUpdatedLeads", fields: [updatedById], references: [id])
  deletedBy         User?              @relation("UserDeletedLeads", fields: [deletedById], references: [id])
  comments          LeadComment[]
  leadNotes         LeadNote[]
  assignments       LeadAssignment[]
  pipelineHistory   PipelineHistory[]
  followups         Followup[]
  notifications     Notification[]
  activities        LeadActivity[]
  communicationLogs CommunicationLog[]

  // SPRINT 5 RELATIONS
  qualification        LeadQualification?
  qualificationHistory LeadQualificationHistory[]
  opportunities        Opportunity[]
  deals                Deal[]
  customers            Customer[]

  @@index([companyId])
  @@index([branchId])
  @@index([pipelineId])
  @@index([stageId])
  @@index([previousStageId])
  @@index([sourceId])
  @@index([courseId])
  @@index([statusId])
  @@index([assignedToId])
  @@index([teamId])
  @@index([mobile])
  @@index([email])
  @@index([alternateMobile])
  @@index([companyId, mobile])
  @@index([isDuplicate])
  @@index([qualificationStatus])
  @@index([isQualified])
  @@index([createdAt])

  // SPRINT 6 ANALYTICS PERFORMANCE INDEXES
  @@index([companyId, createdAt])
  @@index([companyId, branchId, createdAt])
  @@index([companyId, teamId, createdAt])
  @@index([companyId, sourceId])
  @@index([companyId, assignedToId, createdAt])
  @@index([companyId, isQualified, createdAt])
  @@index([companyId, branchId, isQualified])
  @@index([companyId, teamId, isQualified])
  @@map("leads")
}

model LeadStatus {
  id            Int      @id @default(autoincrement())
  companyId     Int?     @map("company_id")
  name          String
  code          String
  displayColor  String   @map("display_color")
  sequenceOrder Int      @default(0) @map("sequence_order")
  isDefault     Boolean  @default(false) @map("is_default")
  isSystem      Boolean  @default(false) @map("is_system")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  company Company? @relation(fields: [companyId], references: [id])
  leads   Lead[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("lead_statuses")
}

model LeadNote {
  id          Int      @id @default(autoincrement())
  leadId      Int      @map("lead_id")
  note        String   @db.Text
  isDeleted   Boolean  @default(false) @map("is_deleted")
  createdById Int      @map("created_by")
  updatedById Int?     @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  lead      Lead  @relation(fields: [leadId], references: [id])
  createdBy User  @relation("LeadNoteCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("LeadNoteUpdatedBy", fields: [updatedById], references: [id])

  @@index([leadId])
  @@map("lead_notes")
}

model LeadImportLog {
  id             Int      @id @default(autoincrement())
  companyId      Int      @map("company_id")
  branchId       Int      @map("branch_id")
  pipelineId     Int?     @map("pipeline_id")
  fileName       String   @map("file_name")
  totalRows      Int      @map("total_rows")
  successCount   Int      @default(0) @map("success_count")
  failureCount   Int      @default(0) @map("failure_count")
  duplicateCount Int      @default(0) @map("duplicate_count")
  status         String   @default("COMPLETED")
  errorReport    Json?    @map("error_report")
  createdById    Int      @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  company   Company   @relation(fields: [companyId], references: [id])
  branch    Branch    @relation(fields: [branchId], references: [id])
  pipeline  Pipeline? @relation(fields: [pipelineId], references: [id])
  createdBy User      @relation("LeadImportLogCreatedBy", fields: [createdById], references: [id])

  @@index([companyId])
  @@index([branchId])
  @@index([createdById])
  @@map("lead_import_logs")
}

model LeadComment {
  id          Int      @id @default(autoincrement())
  leadId      Int      @map("lead_id")
  userId      Int      @map("user_id")
  comment     String
  isDeleted   Boolean  @default(false) @map("is_deleted")
  createdById Int      @map("created_by")
  updatedById Int?     @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  lead Lead @relation(fields: [leadId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@index([leadId])
  @@map("lead_comments")
}

model DailyBranchReport {
  id Int @id @default(autoincrement())

  branchId   Int      @map("branch_id")
  reportDate DateTime @map("report_date")

  callsReceived     Int @default(0) @map("calls_received")
  qualifiedLeads    Int @default(0) @map("qualified_leads")
  counsellingDone   Int @default(0) @map("counselling_done")
  counsellingBooked Int @default(0) @map("counselling_booked")
  officeVisits      Int @default(0) @map("office_visits")
  closures          Int @default(0) @map("closures")
  followupsDone     Int @default(0) @map("followups_done")
  pendingFollowups  Int @default(0) @map("pending_followups")

  isDeleted   Boolean  @default(false) @map("is_deleted")
  createdById Int      @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  branch    Branch @relation(fields: [branchId], references: [id])
  createdBy User   @relation("UserCreatedDailyBranchReports", fields: [createdById], references: [id])

  @@unique([branchId, reportDate, createdById])
  @@index([branchId])
  @@index([createdById])
  @@map("daily_branch_reports")
}

// ============================================================================
// USER PROFILES, SETTINGS, TEAMS, COURSES
// ============================================================================

model UserProfile {
  id        Int  @id @default(autoincrement())
  userId    Int  @unique @map("user_id")
  companyId Int? @map("company_id")
  branchId  Int? @map("branch_id")

  address          String?
  city             String?
  state            String?
  country          String?
  pincode          String?
  emergencyContact String? @map("emergency_contact")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id])
  company Company? @relation(fields: [companyId], references: [id])
  branch  Branch?  @relation(fields: [branchId], references: [id])

  @@index([companyId])
  @@index([branchId])
  @@map("user_profiles")
}

model UserSettings {
  id     Int @id @default(autoincrement())
  userId Int @unique @map("user_id")

  notificationPreferences Json? @map("notification_preferences")
  sessionPreferences      Json? @map("session_preferences")
  securitySettings        Json? @map("security_settings")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("user_settings")
}

model Team {
  id          Int      @id @default(autoincrement())
  companyId   Int      @map("company_id")
  branchId    Int      @map("branch_id")
  name        String   @map("team_name")
  code        String   @map("team_code")
  bdeId       Int      @map("bde_id")
  status      String   @default("ACTIVE")
  isDeleted   Boolean  @default(false) @map("is_deleted")
  createdById Int      @map("created_by")
  updatedById Int?     @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company                   Company          @relation(fields: [companyId], references: [id])
  branch                    Branch           @relation(fields: [branchId], references: [id])
  bde                       User             @relation("TeamBDE", fields: [bdeId], references: [id])
  createdBy                 User             @relation("TeamCreatedBy", fields: [createdById], references: [id])
  updatedBy                 User?            @relation("TeamUpdatedBy", fields: [updatedById], references: [id])
  members                   TeamMember[]
  leads                     Lead[]
  leadAssignmentsReceived   LeadAssignment[] @relation("TeamAssignmentsReceived")
  leadAssignmentsAsPrevious LeadAssignment[] @relation("TeamAssignmentsAsPrevious")

  // SPRINT 5 RELATIONS
  opportunities Opportunity[]
  customers     Customer[]

  // SPRINT 6 RELATIONS
  kpiTargets  KpiTarget[]
  revenueLogs RevenueLog[]

  @@unique([companyId, code])
  @@unique([branchId, name])
  @@index([companyId])
  @@index([branchId])
  @@index([bdeId])
  @@map("teams")
}

model TeamMember {
  id           Int       @id @default(autoincrement())
  teamId       Int       @map("team_id")
  userId       Int       @map("user_id")
  memberRole   String    @map("member_role")
  assignedDate DateTime  @default(now()) @map("assigned_date")
  assignedById Int?      @map("assigned_by_id")
  removedAt    DateTime? @map("removed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  team       Team  @relation(fields: [teamId], references: [id])
  user       User  @relation("TeamMemberUser", fields: [userId], references: [id])
  assignedBy User? @relation("TeamMemberAssignedBy", fields: [assignedById], references: [id])

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

model Course {
  id             Int      @id @default(autoincrement())
  companyId      Int      @map("company_id")
  name           String   @map("course_name")
  code           String   @map("course_code")
  description    String?
  category       String
  parentCategory String?  @map("parent_category")
  price          Decimal  @db.Decimal(10, 2)
  duration       String?
  status         String   @default("ACTIVE")
  isDeleted      Boolean  @default(false) @map("is_deleted")
  createdById    Int      @map("created_by")
  updatedById    Int?     @map("updated_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  company   Company @relation(fields: [companyId], references: [id])
  createdBy User    @relation("CourseCreatedBy", fields: [createdById], references: [id])
  updatedBy User?   @relation("CourseUpdatedBy", fields: [updatedById], references: [id])
  leads     Lead[]

  // SPRINT 5 RELATIONS
  opportunities    Opportunity[]
  proposals        Proposal[]
  proposalVersions ProposalVersion[]
  customers        Customer[]
  revenueLogs      RevenueLog[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([category])
  @@map("courses")
}

model AuditLog {
  id            Int      @id @default(autoincrement())
  companyId     Int?     @map("company_id")
  entityType    String   @map("entity_type")
  entityId      Int      @map("entity_id")
  action        String
  oldValue      Json?    @map("old_value")
  newValue      Json?    @map("new_value")
  performedById Int?     @map("performed_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  company     Company? @relation(fields: [companyId], references: [id])
  performedBy User?    @relation("AuditPerformedBy", fields: [performedById], references: [id])

  @@index([companyId])
  @@index([entityType, entityId])
  @@index([performedById])
  @@map("audit_logs")
}

// ============================================================================
// LEAD ASSIGNMENTS, HISTORY & FOLLOWUPS
// ============================================================================

model LeadAssignment {
  id               Int      @id @default(autoincrement())
  leadId           Int      @map("lead_id")
  companyId        Int      @map("company_id")
  branchId         Int?     @map("branch_id")
  assignmentType   String   @map("assignment_type")
  assignedToUserId Int?     @map("assigned_to_user_id")
  assignedToTeamId Int?     @map("assigned_to_team_id")
  previousUserId   Int?     @map("previous_user_id")
  previousTeamId   Int?     @map("previous_team_id")
  assignedById     Int      @map("assigned_by_id")
  notes            String?  @db.Text
  reason           String?  @db.Text
  assignedAt       DateTime @default(now()) @map("assigned_at")
  createdAt        DateTime @default(now()) @map("created_at")

  lead           Lead    @relation(fields: [leadId], references: [id])
  company        Company @relation(fields: [companyId], references: [id])
  branch         Branch? @relation(fields: [branchId], references: [id])
  assignedToUser User?   @relation("LeadAssignmentsReceived", fields: [assignedToUserId], references: [id])
  assignedToTeam Team?   @relation("TeamAssignmentsReceived", fields: [assignedToTeamId], references: [id])
  previousUser   User?   @relation("LeadAssignmentsAsPrevious", fields: [previousUserId], references: [id])
  previousTeam   Team?   @relation("TeamAssignmentsAsPrevious", fields: [previousTeamId], references: [id])
  assignedByUser User    @relation("LeadAssignmentsMade", fields: [assignedById], references: [id])

  @@index([leadId])
  @@index([companyId])
  @@index([branchId])
  @@index([assignedToUserId])
  @@index([assignedToTeamId])
  @@index([leadId, assignedAt])
  @@map("lead_assignments")
}

model PipelineHistory {
  id              Int      @id @default(autoincrement())
  leadId          Int      @map("lead_id")
  companyId       Int      @map("company_id")
  branchId        Int?     @map("branch_id")
  previousStageId Int?     @map("previous_stage_id")
  newStageId      Int      @map("new_stage_id")
  changedById     Int      @map("changed_by_id")
  reason          String?  @db.Text
  changedAt       DateTime @default(now()) @map("changed_at")
  createdAt       DateTime @default(now()) @map("created_at")

  lead          Lead    @relation(fields: [leadId], references: [id])
  company       Company @relation(fields: [companyId], references: [id])
  branch        Branch? @relation(fields: [branchId], references: [id])
  previousStage Stage?  @relation("PipelineHistoryPreviousStage", fields: [previousStageId], references: [id])
  newStage      Stage   @relation("PipelineHistoryNewStage", fields: [newStageId], references: [id])
  changedByUser User    @relation("PipelineChangesMade", fields: [changedById], references: [id])

  @@index([leadId])
  @@index([companyId])
  @@index([branchId])
  @@index([previousStageId])
  @@index([newStageId])
  @@map("pipeline_histories")
}

model Followup {
  id              Int       @id @default(autoincrement())
  leadId          Int       @map("lead_id")
  companyId       Int       @map("company_id")
  branchId        Int?      @map("branch_id")
  followupType    String    @map("followup_type")
  scheduledAt     DateTime  @map("scheduled_at")
  status          String    @default("PENDING")
  notes           String?   @db.Text
  completionNotes String?   @map("completion_notes") @db.Text
  completedAt     DateTime? @map("completed_at")
  completedById   Int?      @map("completed_by_id")
  assignedToId    Int       @map("assigned_to_id")
  createdById     Int       @map("created_by")
  updatedById     Int?      @map("updated_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  lead          Lead           @relation(fields: [leadId], references: [id])
  company       Company        @relation(fields: [companyId], references: [id])
  branch        Branch?        @relation(fields: [branchId], references: [id])
  completedBy   User?          @relation("FollowupsCompleted", fields: [completedById], references: [id])
  assignedTo    User           @relation("FollowupsAssigned", fields: [assignedToId], references: [id])
  createdBy     User           @relation("FollowupsCreated", fields: [createdById], references: [id])
  updatedBy     User?          @relation("FollowupsUpdated", fields: [updatedById], references: [id])
  notifications Notification[]

  @@index([leadId])
  @@index([companyId])
  @@index([branchId])
  @@index([assignedToId])
  @@index([status])
  @@index([scheduledAt])
  @@index([assignedToId, status, scheduledAt])
  @@index([companyId, assignedToId, status, scheduledAt])
  @@index([companyId, completedById, status])
  @@map("followups")
}

model Notification {
  id               Int       @id @default(autoincrement())
  userId           Int       @map("user_id")
  leadId           Int?      @map("lead_id")
  companyId        Int?      @map("company_id")
  branchId         Int?      @map("branch_id")
  followupId       Int?      @map("followup_id")
  opportunityId    Int?      @map("opportunity_id")
  notificationType String    @map("notification_type")
  message          String    @db.Text
  status           String    @default("UNREAD")
  readAt           DateTime? @map("read_at")
  expiresAt        DateTime? @map("expires_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user        User         @relation("NotificationsReceived", fields: [userId], references: [id])
  lead        Lead?        @relation(fields: [leadId], references: [id])
  company     Company?     @relation(fields: [companyId], references: [id])
  branch      Branch?      @relation(fields: [branchId], references: [id])
  followup    Followup?    @relation(fields: [followupId], references: [id])
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id])

  @@index([userId])
  @@index([leadId])
  @@index([status])
  @@index([createdAt])
  @@index([companyId])
  @@index([branchId])
  @@index([followupId])
  @@index([opportunityId])
  @@map("notifications")
}

// ============================================================================
// SPRINT 5 TABLES — QUALIFICATION, OPPORTUNITY, PROPOSAL, DEAL, CUSTOMER
// ============================================================================

model LeadQualification {
  id        Int  @id @default(autoincrement())
  leadId    Int  @unique @map("lead_id")
  companyId Int  @map("company_id")
  branchId  Int? @map("branch_id")

  status String @default("UNQUALIFIED") @map("status")
  score  Int    @default(0)

  budgetAvailable        Boolean @default(false) @map("budget_available")
  interestLevel          String  @default("MEDIUM") @map("interest_level")
  purchaseTimeline       String? @map("purchase_timeline")
  decisionMakerAvailable Boolean @default(false) @map("decision_maker_available")
  productFit             Boolean @default(false) @map("product_fit")

  criteriaValues Json? @map("criteria_values")

  notes   String? @db.Text
  remarks String? @db.Text

  evaluatedById Int?     @map("evaluated_by_id")
  evaluatedAt   DateTime @default(now()) @map("evaluated_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  lead        Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  company     Company @relation(fields: [companyId], references: [id])
  branch      Branch? @relation(fields: [branchId], references: [id])
  evaluatedBy User?   @relation("LeadQualifiedBy", fields: [evaluatedById], references: [id])

  @@index([companyId])
  @@index([branchId])
  @@index([leadId])
  @@index([status])
  @@map("lead_qualifications")
}

model LeadQualificationHistory {
  id               Int      @id @default(autoincrement())
  leadId           Int      @map("lead_id")
  companyId        Int      @map("company_id")
  branchId         Int?     @map("branch_id")
  previousStatus   String?  @map("previous_status")
  newStatus        String   @map("new_status")
  score            Int?
  remarks          String?  @db.Text
  criteriaSnapshot Json?    @map("criteria_snapshot")
  changedById      Int      @map("changed_by_id")
  changedAt        DateTime @default(now()) @map("changed_at")

  lead      Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id])
  branch    Branch? @relation(fields: [branchId], references: [id])
  changedBy User    @relation("QualificationHistoryChangedBy", fields: [changedById], references: [id])

  @@index([leadId])
  @@index([companyId])
  @@index([branchId])
  @@index([changedAt])
  @@map("lead_qualification_histories")
}

model CompanyQualificationCriteria {
  id           Int      @id @default(autoincrement())
  companyId    Int      @map("company_id")
  key          String
  label        String
  description  String?  @db.Text
  fieldType    String   @map("field_type")
  maxPoints    Int      @map("max_points")
  options      Json?
  defaultValue String?  @map("default_value")
  isRequired   Boolean  @default(false) @map("is_required")
  isActive     Boolean  @default(true) @map("is_active")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([isActive])
  @@map("company_qualification_criteria")
}

model CompanyQualificationSettings {
  id            Int      @id @default(autoincrement())
  companyId     Int      @unique @map("company_id")
  passThreshold Int      @default(60) @map("pass_threshold")
  holdThreshold Int      @default(40) @map("hold_threshold")
  validStatuses Json     @default("[\"QUALIFIED\",\"NOT_QUALIFIED\",\"ON_HOLD\",\"UNQUALIFIED\"]") @map("valid_statuses")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@map("company_qualification_settings")
}

model LeadActivity {
  id                Int      @id @default(autoincrement())
  leadId            Int      @map("lead_id")
  companyId         Int      @map("company_id")
  activityType      String   @map("activity_type")
  description       String?  @db.Text
  metadata          Json?
  relatedEntityType String?  @map("related_entity_type")
  relatedEntityId   Int?     @map("related_entity_id")
  performedById     Int?     @map("performed_by_id")
  performedAt       DateTime @default(now()) @map("performed_at")
  createdAt         DateTime @default(now()) @map("created_at")

  lead        Lead    @relation(fields: [leadId], references: [id])
  company     Company @relation(fields: [companyId], references: [id])
  performedBy User?   @relation("LeadActivitiesPerformed", fields: [performedById], references: [id])

  @@index([leadId])
  @@index([companyId])
  @@index([performedAt])
  @@index([activityType])
  @@index([leadId, performedAt])
  @@index([relatedEntityType, relatedEntityId])
  @@map("lead_activities")
}

model CommunicationLog {
  id                Int       @id @default(autoincrement())
  leadId            Int       @map("lead_id")
  companyId         Int       @map("company_id")
  branchId          Int?      @map("branch_id")
  communicationType String    @map("communication_type")
  summary           String?   @db.Text
  interactionDate   DateTime  @map("interaction_date")
  isDeleted         Boolean   @default(false) @map("is_deleted")
  deletedById       Int?      @map("deleted_by")
  deletedAt         DateTime? @map("deleted_at")
  createdById       Int       @map("created_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  lead      Lead    @relation(fields: [leadId], references: [id])
  company   Company @relation(fields: [companyId], references: [id])
  branch    Branch? @relation(fields: [branchId], references: [id])
  createdBy User    @relation("CommunicationLogsCreated", fields: [createdById], references: [id])
  deletedBy User?   @relation("CommunicationLogsDeleted", fields: [deletedById], references: [id])

  @@index([leadId])
  @@index([companyId])
  @@index([branchId])
  @@index([communicationType])
  @@index([interactionDate])
  @@index([companyId, createdById, communicationType, interactionDate])
  @@map("communication_logs")
}

model OpportunityStage {
  id                    Int      @id @default(autoincrement())
  companyId             Int      @map("company_id")
  name                  String
  code                  String
  stageType             String   @default("REGULAR") @map("stage_type")
  displayOrder          Int      @default(0) @map("display_order")
  colorCode             String   @default("#6366f1") @map("color_code")
  defaultProbabilityPct Int      @default(10) @map("default_probability_pct")
  isSystem              Boolean  @default(false) @map("is_system")
  status                String   @default("ACTIVE")
  createdById           Int?     @map("created_by_id")
  updatedById           Int?     @map("updated_by_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  company                Company                   @relation(fields: [companyId], references: [id])
  createdBy              User?                     @relation("OpportunityStageCreatedBy", fields: [createdById], references: [id])
  updatedBy              User?                     @relation("OpportunityStageUpdatedBy", fields: [updatedById], references: [id])
  opportunities          Opportunity[]
  previousStageHistories OpportunityStageHistory[] @relation("PreviousOpportunityStage")
  newStageHistories      OpportunityStageHistory[] @relation("NewOpportunityStage")

  @@unique([companyId, code])
  @@index([companyId])
  @@index([displayOrder])
  @@map("opportunity_stages")
}

model Opportunity {
  id                    Int      @id @default(autoincrement())
  companyId             Int      @map("company_id")
  branchId              Int?     @map("branch_id")
  opportunityName       String   @map("opportunity_name")
  leadId                Int      @map("lead_id")
  productId             Int?     @map("product_id")
  teamId                Int?     @map("team_id")
  stageId               Int      @map("stage_id")
  ownerId               Int      @map("owner_id")

  expectedRevenue       Decimal  @db.Decimal(12, 2) @map("expected_revenue")
  probabilityPercentage Int      @default(10) @map("probability_percentage")
  closingDate           DateTime @map("closing_date")
  status                String   @default("OPEN") @map("status")
  notes                 String?  @db.Text

  isDeleted   Boolean  @default(false) @map("is_deleted")
  createdById Int      @map("created_by_id")
  updatedById Int?     @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company   Company          @relation(fields: [companyId], references: [id])
  branch    Branch?          @relation(fields: [branchId], references: [id])
  lead      Lead             @relation(fields: [leadId], references: [id])
  product   Course?          @relation(fields: [productId], references: [id])
  team      Team?            @relation(fields: [teamId], references: [id])
  stage     OpportunityStage @relation(fields: [stageId], references: [id])
  owner     User             @relation("OpportunityOwner", fields: [ownerId], references: [id])
  createdBy User             @relation("OpportunityCreatedBy", fields: [createdById], references: [id])
  updatedBy User?            @relation("OpportunityUpdatedBy", fields: [updatedById], references: [id])

  stageHistory  OpportunityStageHistory[]
  proposals     Proposal[]
  deal          Deal?
  customers     Customer[]
  notifications Notification[]

  @@index([companyId])
  @@index([branchId])
  @@index([leadId])
  @@index([productId])
  @@index([teamId])
  @@index([stageId])
  @@index([ownerId])
  @@index([status])
  @@index([closingDate])
  @@index([companyId, createdAt])
  @@index([companyId, ownerId, status])
  @@index([companyId, stageId, status])
  @@index([companyId, teamId, status])
  @@index([companyId, branchId, status])
  @@map("opportunities")
}

model OpportunityStageHistory {
  id              Int      @id @default(autoincrement())
  opportunityId   Int      @map("opportunity_id")
  companyId       Int      @map("company_id")
  branchId        Int?     @map("branch_id")
  previousStageId Int?     @map("previous_stage_id")
  newStageId      Int      @map("new_stage_id")
  changedById     Int      @map("changed_by_id")
  remarks         String?  @db.Text
  changedAt       DateTime @default(now()) @map("changed_at")

  opportunity   Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  company       Company           @relation(fields: [companyId], references: [id])
  branch        Branch?           @relation(fields: [branchId], references: [id])
  previousStage OpportunityStage? @relation("PreviousOpportunityStage", fields: [previousStageId], references: [id])
  newStage      OpportunityStage  @relation("NewOpportunityStage", fields: [newStageId], references: [id])
  changedBy     User              @relation("OpportunityStageChangedBy", fields: [changedById], references: [id])

  @@index([opportunityId])
  @@index([companyId])
  @@index([changedAt])
  @@map("opportunity_stage_histories")
}

model Proposal {
  id             Int      @id @default(autoincrement())
  companyId      Int      @map("company_id")
  branchId       Int?     @map("branch_id")
  proposalNumber String   @map("proposal_number")
  opportunityId  Int      @map("opportunity_id")
  productId      Int?     @map("product_id")

  basePrice      Decimal  @db.Decimal(12, 2) @map("base_price")
  discount       Decimal  @default(0.00) @db.Decimal(12, 2) @map("discount")
  finalAmount    Decimal  @db.Decimal(12, 2) @map("final_amount")
  validTill      DateTime @map("valid_till")
  terms          String?  @db.Text
  status         String   @default("DRAFT") @map("status")
  currentVersion Int      @default(1) @map("current_version")

  isDeleted   Boolean   @default(false) @map("is_deleted")
  deletedById Int?      @map("deleted_by_id")
  deletedAt   DateTime? @map("deleted_at")

  createdById Int      @map("created_by_id")
  updatedById Int?     @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company     Company           @relation(fields: [companyId], references: [id])
  branch      Branch?           @relation(fields: [branchId], references: [id])
  opportunity Opportunity       @relation(fields: [opportunityId], references: [id])
  product     Course?           @relation(fields: [productId], references: [id])
  createdBy   User              @relation("ProposalCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?             @relation("ProposalUpdatedBy", fields: [updatedById], references: [id])
  deletedBy   User?             @relation("ProposalDeletedBy", fields: [deletedById], references: [id])
  versions    ProposalVersion[]

  @@unique([companyId, proposalNumber])
  @@index([companyId])
  @@index([opportunityId])
  @@index([status])
  @@index([validTill])
  @@map("proposals")
}

model ProposalVersion {
  id            Int      @id @default(autoincrement())
  proposalId    Int      @map("proposal_id")
  companyId     Int      @map("company_id")
  branchId      Int?     @map("branch_id")
  versionNumber Int      @map("version_number")

  basePrice    Decimal  @db.Decimal(12, 2) @map("base_price")
  discount     Decimal  @db.Decimal(12, 2) @map("discount")
  finalAmount  Decimal  @db.Decimal(12, 2) @map("final_amount")
  validTill    DateTime @map("valid_till")
  terms        String?  @db.Text
  versionNotes String?  @db.Text @map("version_notes")
  productId    Int?     @map("product_id")

  modifiedById Int      @map("modified_by_id")
  modifiedDate DateTime @default(now()) @map("modified_date")

  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  company    Company  @relation(fields: [companyId], references: [id])
  branch     Branch?  @relation(fields: [branchId], references: [id])
  product    Course?  @relation(fields: [productId], references: [id])
  modifiedBy User     @relation("ProposalVersionCreatedBy", fields: [modifiedById], references: [id])

  @@unique([proposalId, versionNumber])
  @@index([proposalId])
  @@index([companyId])
  @@map("proposal_versions")
}

model WinLossReason {
  id          Int      @id @default(autoincrement())
  companyId   Int      @map("company_id")
  reasonName  String   @map("reason_name")
  reasonType  String   @map("reason_type")
  status      String   @default("ACTIVE")
  createdById Int?     @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company   Company @relation(fields: [companyId], references: [id])
  createdBy User?   @relation("WinLossReasonCreatedBy", fields: [createdById], references: [id])
  deals     Deal[]

  @@unique([companyId, reasonName, reasonType])
  @@index([companyId])
  @@index([reasonType])
  @@map("win_loss_reasons")
}

model Deal {
  id            Int      @id @default(autoincrement())
  companyId     Int      @map("company_id")
  branchId      Int?     @map("branch_id")
  dealNumber    String   @map("deal_number")
  opportunityId Int      @unique @map("opportunity_id")
  leadId        Int      @map("lead_id")

  outcome     String   @map("outcome")
  closingDate DateTime @map("closing_date")
  finalAmount Decimal  @db.Decimal(12, 2) @map("final_amount")
  reasonId    Int?     @map("reason_id")
  remarks     String?  @db.Text

  closedById  Int      @map("closed_by_id")
  createdById Int      @map("created_by_id")
  updatedById Int?     @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company     Company        @relation(fields: [companyId], references: [id])
  branch      Branch?        @relation(fields: [branchId], references: [id])
  opportunity Opportunity    @relation(fields: [opportunityId], references: [id])
  lead        Lead           @relation(fields: [leadId], references: [id])
  reason      WinLossReason? @relation(fields: [reasonId], references: [id])
  closedBy    User           @relation("DealClosedBy", fields: [closedById], references: [id])
  createdBy   User           @relation("DealCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?          @relation("DealUpdatedBy", fields: [updatedById], references: [id])

  histories   DealHistory[]
  customer    Customer?
  revenueLog  RevenueLog?

  @@unique([companyId, dealNumber])
  @@index([companyId])
  @@index([branchId])
  @@index([opportunityId])
  @@index([leadId])
  @@index([outcome])
  @@index([closingDate])
  @@index([companyId, outcome, closingDate])
  @@index([companyId, branchId, closingDate])
  @@index([companyId, closedById, outcome])
  @@map("deals")
}

model DealHistory {
  id             Int      @id @default(autoincrement())
  dealId         Int      @map("deal_id")
  companyId      Int      @map("company_id")
  branchId       Int?     @map("branch_id")
  previousStatus String?  @map("previous_status")
  newStatus      String   @map("new_status")
  remarks        String?  @db.Text
  createdById    Int      @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  deal      Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id])
  branch    Branch? @relation(fields: [branchId], references: [id])
  createdBy User    @relation("DealHistoryCreatedBy", fields: [createdById], references: [id])

  @@index([dealId])
  @@index([companyId])
  @@index([branchId])
  @@map("deal_histories")
}

model Customer {
  id                 Int      @id @default(autoincrement())
  companyId          Int      @map("company_id")
  branchId           Int?     @map("branch_id")
  customerCode       String   @map("customer_code")
  customerName       String   @map("customer_name")
  contactNumber      String   @map("contact_number")
  email              String?

  leadId             Int      @map("lead_id")
  opportunityId      Int      @map("opportunity_id")
  dealId             Int      @unique @map("deal_id")
  purchasedProductId Int?     @map("purchased_product_id")

  purchaseDate    DateTime @default(now()) @map("purchase_date")
  totalRevenue    Decimal  @db.Decimal(12, 2) @map("total_revenue")
  ownerTeamId     Int?     @map("owner_team_id")
  assignedOwnerId Int      @map("assigned_owner_id")
  status          String   @default("ACTIVE") @map("status")

  isDeleted   Boolean   @default(false) @map("is_deleted")
  deletedById Int?      @map("deleted_by_id")
  deletedAt   DateTime? @map("deleted_at")

  createdById Int      @map("created_by_id")
  updatedById Int?     @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company          Company      @relation(fields: [companyId], references: [id])
  branch           Branch?      @relation(fields: [branchId], references: [id])
  lead             Lead         @relation(fields: [leadId], references: [id])
  opportunity      Opportunity  @relation(fields: [opportunityId], references: [id])
  deal             Deal         @relation(fields: [dealId], references: [id])
  purchasedProduct Course?      @relation(fields: [purchasedProductId], references: [id])
  ownerTeam        Team?        @relation(fields: [ownerTeamId], references: [id])
  assignedOwner    User         @relation("CustomerOwner", fields: [assignedOwnerId], references: [id])
  createdBy        User         @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  updatedBy        User?        @relation("CustomerUpdatedBy", fields: [updatedById], references: [id])
  deletedBy        User?        @relation("CustomerDeletedBy", fields: [deletedById], references: [id])
  revenueLogs      RevenueLog[]

  @@unique([companyId, customerCode])
  @@index([companyId])
  @@index([branchId])
  @@index([leadId])
  @@index([dealId])
  @@index([assignedOwnerId])
  @@index([ownerTeamId])
  @@map("customers")
}

model RevenueLog {
  id            Int      @id @default(autoincrement())
  companyId     Int      @map("company_id")
  branchId      Int?     @map("branch_id")
  teamId        Int?     @map("team_id")
  dealId        Int      @map("deal_id")
  customerId    Int      @map("customer_id")
  productId     Int?     @map("product_id")

  revenueAmount Decimal  @db.Decimal(12, 2) @map("revenue_amount")
  revenueDate   DateTime @default(now()) @map("revenue_date")
  paymentStatus String   @default("COMPLETED") @map("payment_status")
  notes         String?  @db.Text

  createdById   Int      @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  company   Company  @relation(fields: [companyId], references: [id])
  branch    Branch?  @relation(fields: [branchId], references: [id])
  team      Team?    @relation(fields: [teamId], references: [id])
  deal      Deal     @relation(fields: [dealId], references: [id])
  customer  Customer @relation(fields: [customerId], references: [id])
  product   Course?  @relation(fields: [productId], references: [id])
  createdBy User     @relation("RevenueLogCreatedBy", fields: [createdById], references: [id])

  @@unique([dealId])
  @@index([companyId])
  @@index([branchId])
  @@index([teamId])
  @@index([customerId])
  @@index([productId])
  @@index([revenueDate])
  @@index([companyId, revenueDate])
  @@index([branchId, revenueDate])
  @@index([companyId, branchId, revenueDate])
  @@index([companyId, teamId, revenueDate])
  @@index([companyId, productId])
  @@map("revenue_logs")
}

// ============================================================================
// SPRINT 6 TABLES — REPORTS, ANALYTICS & DASHBOARD MODULE
// ============================================================================

model Report {
  id             Int      @id @default(autoincrement())
  companyId      Int?     @map("company_id")
  reportName     String   @map("report_name")
  reportCode     String   @unique @map("report_code")
  reportType     String   @map("report_type")
  category       String   @map("category")
  description    String?  @db.Text
  allowedRoles   Json?    @map("allowed_roles") // Task 1.6: E.g. ["SUPER_ADMIN", "COMPANY_ADMIN", "BRANCH_MANAGER"]
  isSystem       Boolean  @default(false) @map("is_system")
  status         String   @default("ACTIVE")
  createdById    Int?     @map("created_by_id")
  updatedById    Int?     @map("updated_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  company      Company?             @relation(fields: [companyId], references: [id])
  createdBy    User?                @relation("ReportCreatedBy", fields: [createdById], references: [id])
  updatedBy    User?                @relation("ReportUpdatedBy", fields: [updatedById], references: [id])
  savedFilters ReportFilter[]
  exportLogs   ExportLog[]
  favoritedBy  UserFavoriteReport[]
  viewLogs     ReportViewLog[]

  @@index([companyId])
  @@index([category])
  @@index([reportType])
  @@map("reports")
}

model UserFavoriteReport {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  reportId  Int      @map("report_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([userId, reportId])
  @@index([userId])
  @@map("user_favorite_reports")
}

model ReportViewLog {
  id       Int      @id @default(autoincrement())
  userId   Int      @map("user_id")
  reportId Int      @map("report_id")
  viewedAt DateTime @default(now()) @map("viewed_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([userId, viewedAt])
  @@index([reportId])
  @@map("report_view_logs")
}

model ReportFilter {
  id           Int      @id @default(autoincrement())
  companyId    Int      @map("company_id")
  branchId     Int?     @map("branch_id")
  reportId     Int?     @map("report_id")
  userId       Int      @map("user_id")
  filterName   String   @map("filter_name")
  reportConfig Json     @map("report_config") // Stores filters, date ranges, selected columns, sorting, grouping
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])
  branch  Branch? @relation(fields: [branchId], references: [id])
  report  Report? @relation(fields: [reportId], references: [id])
  user    User    @relation("UserSavedReportFilters", fields: [userId], references: [id])

  @@index([companyId])
  @@index([userId])
  @@index([reportId])
  @@map("report_filters")
}

model DashboardWidget {
  id              Int      @id @default(autoincrement())
  companyId       Int?     @map("company_id")
  widgetName      String   @map("widget_name")
  widgetCode      String   @map("widget_code")
  widgetType      String   @map("widget_type")
  roleAccess      Json     @map("role_access")
  displayOrder    Int      @default(0) @map("display_order")
  refreshInterval Int      @default(300) @map("refresh_interval")
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  company Company? @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([widgetType])
  @@map("dashboard_widgets")
}

model UserDashboardConfig {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique @map("user_id")
  companyId    Int      @map("company_id")
  layoutConfig Json     @map("layout_config") // Grid coordinates, visible widget IDs, custom refresh preferences
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("user_dashboard_configs")
}

model KpiTarget {
  id            Int      @id @default(autoincrement())
  companyId     Int      @map("company_id")
  branchId      Int?     @map("branch_id")
  teamId        Int?     @map("team_id")
  employeeId    Int?     @map("employee_id")
  kpiType       String   @map("kpi_type")
  targetValue   Decimal  @db.Decimal(12, 2) @map("target_value")
  achievedValue Decimal  @default(0.00) @db.Decimal(12, 2) @map("achieved_value")
  duration      String   @default("MONTHLY") @map("duration")
  startDate     DateTime @map("start_date")
  endDate       DateTime @map("end_date")
  status        String   @default("ACTIVE")
  createdById   Int      @map("created_by_id")
  updatedById   Int?     @map("updated_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  company          Company             @relation(fields: [companyId], references: [id])
  branch           Branch?             @relation(fields: [branchId], references: [id])
  team             Team?               @relation(fields: [teamId], references: [id])
  employee         User?               @relation("UserKpiTargets", fields: [employeeId], references: [id])
  createdBy        User                @relation("KpiTargetCreatedBy", fields: [createdById], references: [id])
  updatedBy        User?               @relation("KpiTargetUpdatedBy", fields: [updatedById], references: [id])
  achievementLogs  KpiAchievementLog[]

  @@index([companyId])
  @@index([branchId])
  @@index([teamId])
  @@index([employeeId])
  @@index([kpiType])
  @@index([startDate, endDate])
  @@index([companyId, kpiType, startDate, endDate])
  @@map("kpi_targets")
}

model KpiAchievementLog {
  id               Int      @id @default(autoincrement())
  kpiTargetId      Int      @map("kpi_target_id")
  companyId        Int      @map("company_id")
  achievedValue    Decimal  @db.Decimal(12, 2) @map("achieved_value")
  sourceEntityType String?  @map("source_entity_type")
  sourceEntityId   Int?     @map("source_entity_id")
  recordedAt       DateTime @default(now()) @map("recorded_at")

  kpiTarget KpiTarget @relation(fields: [kpiTargetId], references: [id], onDelete: Cascade)
  company   Company   @relation(fields: [companyId], references: [id])

  @@index([kpiTargetId])
  @@index([companyId])
  @@index([recordedAt])
  @@map("kpi_achievement_logs")
}

model ExportLog {
  id           Int      @id @default(autoincrement())
  companyId    Int      @map("company_id")
  branchId     Int?     @map("branch_id")
  reportId     Int?     @map("report_id")
  reportName   String   @map("report_name")
  exportType   String   @map("export_type")
  fileName     String   @map("file_name")
  filtersUsed  Json?    @map("filters_used")
  exportedById Int      @map("exported_by_id")
  exportedAt   DateTime @default(now()) @map("exported_at")

  company    Company @relation(fields: [companyId], references: [id])
  branch     Branch? @relation(fields: [branchId], references: [id])
  report     Report? @relation(fields: [reportId], references: [id])
  exportedBy User    @relation("UserExportLogs", fields: [exportedById], references: [id])

  @@index([companyId])
  @@index([branchId])
  @@index([exportedById])
  @@index([exportedAt])
  @@map("export_logs")
}

model AnalyticsSnapshot {
  id           Int      @id @default(autoincrement())
  companyId    Int      @map("company_id")
  branchId     Int      @default(0) @map("branch_id") // 0 = Company-level snapshot (prevents PostgreSQL NULL != NULL unique index bypass)
  snapshotType String   @map("snapshot_type")
  snapshotDate DateTime @map("snapshot_date")
  snapshotData Json     @map("snapshot_data")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, branchId, snapshotType, snapshotDate])
  @@index([companyId])
  @@index([companyId, snapshotType])
  @@index([snapshotDate])
  @@map("analytics_snapshots")
}